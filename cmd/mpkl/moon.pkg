import {
  "mizchi/pkl",
  "mizchi/x/http",
  "mizchi/zlib",
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/crypto",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

// `main.mbt` is the native / JS CLI with async file, package, and network IO.
// `main_wasm.mbt` is the synchronous Marketplace entry for inline source or a
// local file tree. Keep the source sets target-specific so network and package
// fetching remain outside the Wasm command.

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": [ "native", "js" ],
    "main_wbtest.mbt": [ "native", "js" ],
    "stdlib_check.mbt": [ "native", "js" ],
    "fetch_native.mbt": [ "native" ],
    "fetch_js.mbt": [ "js" ],
    "package_download.mbt": [ "native", "js" ],
    "package_download_wbtest.mbt": [ "native" ],
    "package_cache_native.mbt": [ "native", "js" ],
    "main_wasm.mbt": [ "wasm", "wasm-gc" ],
    "main_wasm_wbtest.mbt": [ "wasm", "wasm-gc" ],
  },
)
