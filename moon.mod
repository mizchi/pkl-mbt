name = "mizchi/pkl"

version = "0.7.0"

import {
  "mizchi/cst@0.1.10",
  "mizchi/ripple@0.1.4",
  "mizchi/x@0.5.2",
  "mizchi/zlib@0.4.8",
  "moonbitlang/async@0.20.3",
  "moonbitlang/regexp@0.3.5",
  "moonbitlang/x@0.4.50",
  "moonbit-community/yaml@0.0.6",
}

readme = "README.mbt.md"

repository = "https://github.com/mizchi/pkl-mbt"

license = "Apache-2.0"

keywords = [ "moonbit", "pkl", "parser", "interpreter", "typechecker" ]

description = "Pure MoonBit parser, interpreter, and typechecker experiments for Apple's Pkl language."

preferred_target = "js"
